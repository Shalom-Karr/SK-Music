{
  // SK Music — static-first deploy on Cloudflare Workers Static Assets.
  // The UI + prebuilt data + client-side search index live in dist/ (built by engine/build-static.mjs);
  // this Worker just serves them and handles the routes that can't be static (live playlist, trending, OG).
  "name": "skmusic",
  "main": "engine/index.mjs",
  "account_id": "<your-cloudflare-account-id>",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // NOTE: run_worker_first is deliberately ABSENT. The array form makes every non-listed asset-miss
  // serve the SPA without ever invoking the Worker (breaking /playlist, /zp-live, /a, …), and the
  // boolean form routes all ~19k asset requests through the Worker. Browser navigations to /trending
  // therefore get the SPA (Cloudflare's SPA-mode navigation short-circuit); the SPA router immediately
  // location.replace()s them to /charts, and non-navigation requests still reach the Worker's
  // /trending content negotiation.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // KV: the Worker serves any page override found here before static assets, and caches the live
  // curated trending playlists (refreshed by the cron below).
  "kv_namespaces": [{ "binding": "PAGES", "id": "<your-kv-namespace-id>" }],
  // R2 Bucket for cached MP3 audio files
  "r2_buckets": [{ "binding": "AUDIO_BUCKET", "bucket_name": "sk-music-audio" }],
  // Vercel streaming backend URL
  "vars": { "STREAM_SERVER_URL": "https://<your-vercel-backend>.vercel.app" },
  // Refresh the curated trending playlists into KV 15 min after the upstream index regenerates them
  // (it updates at 08:00/20:00 UTC — both fixed UTC, so 08:15/20:15 UTC never drifts with DST).
  // The same tick also pulls the Zemer app's listening stats (tracking.zemer.io /stats/public) and
  // resolves them to catalog song/artist ids for the /trending blend.
  // scheduled() → refreshTrending() + refreshExternalTrending() in engine/index.mjs.
  "triggers": { "crons": ["15 8,20 * * *"] },
  "observability": { "enabled": true }
}
